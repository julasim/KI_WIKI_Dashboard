# ============================================================
# KI-OS Dashboard — Environment-Variablen
# ============================================================

# --- Vault ---
VAULT_PATH=/vault

# --- Server-Konfig ---
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=5000
HOSTNAME=0.0.0.0

# --- Auth.js (Login) ---
# Generiere mit: openssl rand -base64 32
NEXTAUTH_SECRET=

# Externe URL des Dashboards (für Cookie-Domain + Callbacks).
# Beispiel: https://wiki-dashboard.sima.business
NEXTAUTH_URL=

# Login-User (single-user mode)
DASHBOARD_USER_EMAIL=julius@sima.or.at

# Bcrypt-Hash deines Passworts.
#
# WICHTIG: bcrypt-Hashes enthalten `$`-Zeichen. docker-compose env_file
# interpretiert `$` als Variable-Expansion → der Hash wird kaputt.
# Lösung: jedes `$` mit `$$` escapen.
#
# Generiere den Hash + die docker-compose-safe Zeile mit:
#   docker compose exec dashboard node scripts/hash-password.mjs "deinpw"
#
# Das Script gibt direkt die richtige Zeile aus mit `$$`-Escape, einfach
# hier reinpasten.
#
# Beispiel (NICHT übernehmen — generiere eigenen Hash):
#   DASHBOARD_USER_PASSWORD_HASH=$$2a$$12$$cX6DUwRxSJgCua6n7LmwIuVPb2eZktXJAfmwYG7d/VLRMuVVC3jU.
DASHBOARD_USER_PASSWORD_HASH=

# --- MCP-Integration (Phase B) ---
# Dashboard schreibt ins Vault über den MCP-Server. URL ist die TLS-URL,
# Token ist der gleiche wie in /opt/mcp/.env (oder neu via rotate_token.py).
MCP_BASE_URL=https://wiki-mcp.sima.business/mcp/

# WICHTIG: Auch hier $$ statt $ wegen docker-compose env_file Parser.
# Der MCP_TOKEN aus /opt/mcp/.env ist URL-safe-base64 und enthält normalerweise
# kein $-Zeichen — also meist 1:1 übernehmbar.
MCP_TOKEN=
