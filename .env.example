# ============================================================
# KI-OS Dashboard — Environment-Variablen
# ============================================================

# --- Vault ---
VAULT_PATH=/vault

# --- Server-Konfig ---
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=5000
HOSTNAME=0.0.0.0

# --- Auth.js (Login) ---
# Generiere mit: openssl rand -base64 32
NEXTAUTH_SECRET=

# Externe URL des Dashboards (für Cookie-Domain + Callbacks).
# Beispiel: https://dashboard.sima.business
NEXTAUTH_URL=

# Login-User (single-user mode)
DASHBOARD_USER_EMAIL=julius@sima.or.at

# Bcrypt-Hash deines Passworts.
# Generiere mit: node scripts/hash-password.mjs "deinpasswort"
DASHBOARD_USER_PASSWORD_HASH=

# --- Phase B: MCP-Integration (kommt später) ---
# Wird in Phase B benötigt für Schreibfunktionen.
# MCP_BASE_URL=https://wiki-mcp.sima.business/mcp/
# MCP_TOKEN=
